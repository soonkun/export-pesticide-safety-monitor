# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# --- 농촌진흥청 수출농산물 농약안전사용지침 (odcloud, 국내망 접근) ---
RDA_SERVICE_KEY=여기에_RDA_serviceKey

# --- WTO ePing (해외, apiportal.wto.org에서 무료 발급) ---
WTO_API_KEY=여기에_WTO_subscription_key

# --- 로컬 테스트에서 TLS 검증을 끄려면 1 (운영에서는 절대 켜지 마세요) ---
# PESTICIDE_INSECURE=0

# --- 이메일(SMTP) : 담당자들에게 보고서 발송 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=receiver1@example.com,receiver2@example.com

# --- 카카오 '나에게 보내기' : 본인 카톡 수신 (Kakao Developers) ---
KAKAO_REST_KEY=
KAKAO_REFRESH_TOKEN=

# --- 보고 시각(시) ---
REPORT_HOUR=9
